<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Pmcl.Ecxp</RootNamespace>
    <PackageId>Pmcl.Ecxp</PackageId>
    <Version>1.0.0</Version>
    <Authors>PCML-Z</Authors>
    <Description>Build ECXP apps for the PMCL Minecraft launcher: .NET 10 / .NET 11 window tools that call the launcher API.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/Pmcl.Ecxp.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
